# ─────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env.local и заполните значения.
#  .env.local в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase — публичные значения, они попадают в клиентский бандл.
# Это нормально ТОЛЬКО при включённом RLS на всех таблицах.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Почта администратора для входа через Supabase Auth.
# Значение видно в собранном бандле — секретом не является.
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ── Только для скриптов и серверных функций (в бандл не попадает) ──

# Базовый адрес сайта для генерации sitemap.xml
SITE_URL=https://muhammadali-blog.vercel.app

# Переменные окружения Vercel для api/og.js.
# Задаются в панели Vercel, а не в этом файле.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
