# ─────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env.local и заполните значения.
#  .env.local в git не попадает (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# Supabase — публичные значения, они попадают в клиентский бандл.
# Это нормально ТОЛЬКО при включённом RLS на всех таблицах.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Почта администратора для входа через Supabase Auth.
# Значение видно в собранном бандле — секретом не является.
VITE_ADMIN_EMAIL=admin@yourdomain.com

# ── Только для скриптов и серверных функций (в бандл не попадает) ──

# Базовый адрес сайта для генерации sitemap.xml
SITE_URL=https://muhammadali-blog.vercel.app

# Переменные окружения Vercel для api/og.js.
# Задаются в панели Vercel, а не в этом файле.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── MCP-сервер (api/mcp.js) — тоже только в панели Vercel ──
# MCP_TOKEN=            длинная случайная строка: openssl rand -hex 32
# SUPABASE_SERVICE_ROLE_KEY=   Supabase → Project Settings → API → service_role.
#                              Обходит RLS — никогда не добавляйте префикс VITE_.

# ── Раздел «Видео»: хранилище Cloudflare R2 (только Vercel, без VITE_) ──
# R2_ACCOUNT_ID=          Cloudflare → R2 → Account ID
# R2_ACCESS_KEY_ID=       R2 → Manage API tokens → Object Read & Write на бакет
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=              имя бакета, например videos
# R2_PUBLIC_BASE_URL=     https://media.izzatullaev.uz (свой домен бакета)

# ── Рассылка (api/newsletter.js), только Vercel ──
# RESEND_API_KEY=         НЕ VITE_RESEND_API_KEY: с префиксом VITE_ ключ попадает в код сайта
# RESEND_FROM=            необязательно, «Имя <hello@izzatullaev.uz>» после подтверждения домена
# SUPABASE_ANON_KEY=      для api/og.js и api/sitemap.js

